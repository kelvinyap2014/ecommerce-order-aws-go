{
  "Comment": "E-Commerce Order Verification and Orchestration Workflow - With Exponential Backoff & Error Handling",
  "StartAt": "CheckAddress",
  "States": {
    "CheckAddress": {
      "Type": "Task",
      "Resource": "${AddressLambdaArn}",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["States.Timeout", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleAddressCheckError",
          "ResultPath": "$.system_error"
        }
      ],
      "Next": "AddressCheckChoice"
    },

    "HandleAddressCheckError": {
      "Type": "Pass",
      "Result": {
        "address_check_passed": false,
        "reason": "System error during address validation - please retry or contact support"
      },
      "ResultPath": "$",
      "Next": "AddressCheckChoice"
    },

    "AddressCheckChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.address_check_passed",
          "BooleanEquals": false,
          "Next": "SetAddressFailed"
        }
      ],
      "Default": "CheckCredit"
    },

    "SetAddressFailed": {
      "Type": "Task",
      "Resource": "${UpdateStatusLambdaArn}",
      "Parameters": {
        "order_id.$": "$.order_id",
        "customer_id.$": "$.customer_id",
        "items.$": "$.items",
        "shipping_address.$": "$.shipping_address",
        "total_amount.$": "$.total_amount",
        "created_at.$": "$.created_at",
        "target_status": "ADDRESS_FAILED",
        "reason.$": "$.reason"
      },
      "End": true
    },

    "CheckCredit": {
      "Type": "Task",
      "Resource": "${CreditLambdaArn}",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["States.Timeout", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleCreditCheckError",
          "ResultPath": "$.system_error"
        }
      ],
      "Next": "CreditCheckChoice"
    },

    "HandleCreditCheckError": {
      "Type": "Pass",
      "Result": {
        "credit_check_passed": false,
        "reason": "System error during credit check - please retry or contact support"
      },
      "ResultPath": "$",
      "Next": "CreditCheckChoice"
    },

    "CreditCheckChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.credit_check_passed",
          "BooleanEquals": false,
          "Next": "SetCreditFailed"
        }
      ],
      "Default": "CheckPayment"
    },

    "SetCreditFailed": {
      "Type": "Task",
      "Resource": "${UpdateStatusLambdaArn}",
      "Parameters": {
        "order_id.$": "$.order_id",
        "customer_id.$": "$.customer_id",
        "items.$": "$.items",
        "shipping_address.$": "$.shipping_address",
        "total_amount.$": "$.total_amount",
        "created_at.$": "$.created_at",
        "target_status": "CREDIT_FAILED",
        "reason.$": "$.reason"
      },
      "End": true
    },

    "CheckPayment": {
      "Type": "Task",
      "Resource": "${PaymentLambdaArn}",
      "TimeoutSeconds": 30,
      "Retry": [
        {
          "ErrorEquals": ["States.Timeout", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandlePaymentCheckError",
          "ResultPath": "$.system_error"
        }
      ],
      "Next": "PaymentCheckChoice"
    },

    "HandlePaymentCheckError": {
      "Type": "Pass",
      "Result": {
        "payment_check_passed": false,
        "reason": "System error during payment authorization - please retry or contact support"
      },
      "ResultPath": "$",
      "Next": "PaymentCheckChoice"
    },

    "PaymentCheckChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.payment_check_passed",
          "BooleanEquals": false,
          "Next": "SetPaymentFailed"
        }
      ],
      "Default": "SetVerified"
    },

    "SetPaymentFailed": {
      "Type": "Task",
      "Resource": "${UpdateStatusLambdaArn}",
      "Parameters": {
        "order_id.$": "$.order_id",
        "customer_id.$": "$.customer_id",
        "items.$": "$.items",
        "shipping_address.$": "$.shipping_address",
        "total_amount.$": "$.total_amount",
        "created_at.$": "$.created_at",
        "target_status": "PAYMENT_FAILED",
        "reason.$": "$.reason"
      },
      "End": true
    },

    "SetVerified": {
      "Type": "Task",
      "Resource": "${UpdateStatusLambdaArn}",
      "TimeoutSeconds": 30,
      "Parameters": {
        "order_id.$": "$.order_id",
        "customer_id.$": "$.customer_id",
        "items.$": "$.items",
        "shipping_address.$": "$.shipping_address",
        "total_amount.$": "$.total_amount",
        "created_at.$": "$.created_at",
        "target_status": "VERIFIED"
      },
      "Next": "DispatchToWMS"
    },

    "DispatchToWMS": {
      "Type": "Task",
      "Resource": "${WmsIntegrationLambdaArn}",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": ["States.Timeout", "States.TaskFailed"],
          "IntervalSeconds": 1,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "HandleWmsDispatchError",
          "ResultPath": "$.system_error"
        }
      ],
      "Next": "WmsDispatchSuccess"
    },

    "HandleWmsDispatchError": {
      "Type": "Pass",
      "Result": {
        "wms_dispatch_failed": true,
        "reason": "System error during WMS dispatch - warehouse team will review this order"
      },
      "ResultPath": "$",
      "Next": "WmsDispatchSuccess"
    },

    "WmsDispatchSuccess": {
      "Type": "Pass",
      "Result": "Order verification and dispatch workflow completed",
      "End": true
    }
  }
}
